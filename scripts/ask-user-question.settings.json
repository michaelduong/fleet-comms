      {
        "matcher": "^AskUserQuestion$",
        "hooks": [
          {
            "type": "command",
            "command": "FM_HOME='/path/to/firstmate-home' python3 '/path/to/fleet-comms/scripts/ask-user-question.py'",
            "timeout": 310
          }
        ]
      }
    ]
  }
}
